# Copie este arquivo para .env e preencha com os seus valores.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux/macOS)
#
# O .env esta no .gitignore e nao vai para o repositorio.

# Obrigatorio. Token do bot, criado com o @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=

# Opcional. Minutos entre cada checagem das rotas (padrao: 15).
# Rotas movimentadas custam mais requests -- veja a tabela no README.
POLL_MINUTES=15

# Opcional. Caminho do banco SQLite (padrao: blablacarfind.db, ao lado do codigo).
# Util para manter o banco fora da pasta do repositorio.
BLABLACARFIND_DB=

# Opcional. Fuso horario usado para decidir que dia e "hoje" (nome IANA).
# Em branco, o bot detecta o fuso do sistema automaticamente. Preencha quando o
# servidor estiver em um fuso diferente do das viagens, por exemplo um VPS em UTC.
TIMEZONE=
